# URL del backend FastAPI (vacío = http://localhost:8000)
API_URL=http://localhost:8000

# Credenciales del panel admin
ADMIN_EMAIL=admin@amishi.cl
# Contraseña inicial. Después del primer cambio en Admin → Seguridad se usa auth.json.
ADMIN_PASSWORD=cambiar-en-produccion

# Clave para firmar los tokens JWT (mínimo 32 caracteres aleatorios)
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generar-un-secreto-largo-y-aleatorio

# Orígenes CORS permitidos (separados por coma). Vacío = solo localhost:3000.
# Ejemplo en producción: https://amishi.vercel.app
CORS_ORIGINS=

# Nombre del bucket S3 para persistir catalog.json (solo en AWS Lambda).
# Si no está definida, se usa el filesystem local.
S3_BUCKET=

# Ruta alternativa del catálogo local. Se usa principalmente para aislar tests.
# En desarrollo normal se puede dejar vacía para usar data/catalog.json.
CATALOG_PATH=
